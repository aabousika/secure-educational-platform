APP_NAME=Secure Educational Platform API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FERNET_KEY=replace_with_generated_fernet_key
CERTIFICATE_PRIVATE_KEY_PATH=keys/certificate_private_key.pem
CERTIFICATE_PUBLIC_KEY_PATH=keys/certificate_public_key.pem
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
